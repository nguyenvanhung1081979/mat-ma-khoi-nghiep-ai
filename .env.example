# Sao chép file này thành .env (chỉ dùng để test local với `vercel dev`),
# và khai báo các biến này trên Vercel Dashboard > Settings > Environment Variables
# (hoặc qua lệnh `vercel env add <TÊN_BIẾN>`) để chạy trên production.

# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BÍ MẬT — không lộ ra frontend, không commit lên git

# ---- Bucket chứa file ebook trong Supabase Storage ----
EBOOK_STORAGE_BUCKET=ebooks
EBOOK_FILE_PATH=book.epub
EBOOK_FILE_PATH_PDF=book.pdf

# ---- Giá bán (VND) ----
EBOOK_PRICE_VND=99000

# ---- Thông tin ngân hàng nhận tiền, dùng để sinh mã QR VietQR ----
# Tra mã BIN ngân hàng chính xác tại: https://api.vietqr.io/v2/banks
BANK_BIN=970436
BANK_ACCOUNT_NO=0123456789
BANK_ACCOUNT_NAME=NGUYEN VAN A

# ---- SePay (Tích hợp > Webhook > chọn xác thực "API Key") ----
SEPAY_API_KEY=dat-mot-chuoi-bi-mat-tu-chon

# ---- Telegram Bot (tạo qua @BotFather) ----
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ---- Resend (gửi email giao sách) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev
